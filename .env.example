# Copy to .env.local for `vercel dev`, and add the same keys in Vercel → Project → Settings → Environment Variables.
# None of these are ever sent to a client.

# Shared by every site
GROQ_API_KEY=

# One Web3Forms access key per site (each key delivers to that site's own inbox)
WEB3FORMS_KEY_DULHANIYAA=
# WEB3FORMS_KEY_SUPERFARM=

# Optional: shared rate limiting across serverless instances.
# Leave empty to use the in-memory fallback (per instance, fine for dev / low traffic).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Logging (optional)
# LOG_LEVEL=info          # debug | info | warn | error  (debug also logs each Upstash call)
# LOG_PAYLOADS=true       # false = don't log prompts, AI replies or email bodies (they contain customer data)
